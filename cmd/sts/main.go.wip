// Command sts is a small RFC 8693 security token service. It verifies human
// tokens (customer IdP, employee IdP) and workload tokens (k8s SA / SPIRE)
// against their JWKS, checks entitlement and runnability in OpenFGA, and mints
// delegation and on-behalf-of tokens carrying the full act chain.
package main

import (
	"context"
	"crypto/tls"
	"flag"
	"log/slog"
	"net/http"
	"os"
	"os/signal"
	"syscall"
	"time"

	"sts/sts"
)

func main() {
	cfgPath := flag.String("config", "config.yaml", "config file")
	flag.Parse()
	log := slog.New(slog.NewJSONHandler(os.Stdout, nil))

	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
	defer stop()

	cfg, err := sts.LoadConfig(*cfgPath)
	if err != nil {
		log.Error("config", "err", err)
		os.Exit(1)
	}
	authz, err := newAuthorizer(cfg)
	if err != nil {
		log.Error("authorizer", "err", err)
		os.Exit(1)
	}
	srv, _, err := cfg.Build(ctx, authz)
	if err != nil {
		log.Error("build", "err", err)
		os.Exit(1)
	}

	h := &http.Server{
		Addr:              cfg.Listen,
		Handler:           srv.Handler(),
		ReadHeaderTimeout: 5 * time.Second,
		TLSConfig:         &tls.Config{MinVersion: tls.VersionTLS12},
	}
	go func() {
		<-ctx.Done()
		sc, cancel := context.WithTimeout(context.Background(), 5*time.Second)
		defer cancel()
		_ = h.Shutdown(sc)
	}()

	log.Info("sts listening", "addr", cfg.Listen, "issuer", cfg.Issuer)
	cert, key := os.Getenv("STS_TLS_CERT"), os.Getenv("STS_TLS_KEY")
	if cert != "" && key != "" {
		err = h.ListenAndServeTLS(cert, key)
	} else {
		log.Warn("serving PLAINTEXT: set STS_TLS_CERT/STS_TLS_KEY, or terminate TLS at a proxy")
		err = h.ListenAndServe()
	}
	if err != nil && err != http.ErrServerClosed {
		log.Error("serve", "err", err)
		os.Exit(1)
	}
}
