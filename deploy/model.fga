# OpenFGA authorization model backing the four STS gate checks (see
# sts/authz.go's Authorizer interface and sts/authz_openfga.go).
#
# Four relations, one per Authorizer method:
#   - customer#handled_by  backs HandledBy(employee, customer)
#   - segment#member       backs InSegment(principal, segment) — the port
#     receives segment names bare (e.g. "retail-vip"), so the OpenFGA
#     implementation itself prepends "segment:" before checking membership
#   - agent#can_invoke     backs CanInvoke(principal, agent)
#   - agent#can_run        backs CanRun(runner, agent)
#
# can_invoke is DERIVED, not a flat tuple: an agent is invokable by anyone
# who is a member of one of its entitled segments. This is deliberately a
# different encoding of the same fact than the file-backed StaticAuthorizer
# uses (which stores can_invoke pre-resolved) — see deploy/tuples.openfga.yaml
# and deploy/tuples.yaml, and authz_openfga_parity_test.go, which proves the two
# stay in agreement despite the different modelling.
#
# Load with: fga model write --store-id <id> --file deploy/model.fga
model
  schema 1.1

type customer
  relations
    # authority: which employee is allowed to act for this customer
    define handled_by: [employee]

type employee

type segment
  relations
    define member: [customer, employee]

type runner

type agent
  relations
    # entitlement: which segments may invoke this agent
    define invokable_by: [segment#member]
    define can_invoke: invokable_by
    # execution: which runners may EXECUTE this agent (spec §3.3). A
    # separate relation from invokable_by on purpose: a human being
    # entitled to an agent says nothing about which process may run it,
    # and a model where one implied the other would hand every runner
    # every agent some customer was entitled to.
    define runnable_by: [runner]
    define can_run: runnable_by
